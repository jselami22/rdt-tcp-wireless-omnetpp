config *.host*.tcp.conn-*.sndNxt:vector.result-recording-modes default
config *.host*.tcp.conn-*.sndUna:vector.result-recording-modes default
config *.host*.tcp.conn-*.mss:stats.result-recording-modes default
config *.hostA.app[0].packetSent:count.result-recording-modes default
config *.hostA.app[0].packetReceived:count.result-recording-modes default
config *.hostB.app[0].packetSent:count.result-recording-modes default
config *.hostB.app[0].packetReceived:count.result-recording-modes default
