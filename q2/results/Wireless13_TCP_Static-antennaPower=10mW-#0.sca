version 3
run Wireless13_TCP_Static-1-20251207-16:13:13-7851
attr configname Wireless13_TCP_Static
attr datetime 20251207-16:13:13
attr datetimef 20251207-161313
attr experiment Wireless13_TCP_Static
attr inifile omnetpp.ini
attr iterationvars $antennaPower=10mW
attr iterationvarsd antennaPower=10mW
attr iterationvarsf antennaPower=10mW-
attr measurement $antennaPower=10mW
attr network WirelessC
attr processid 7851
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 1
attr seedset 1
itervar antennaPower 10mW
config image-path ../../images
config description "Q2: TCP Performance - Antenna Power Sweep (Static Nodes)"
config extends Wireless13
config sim-time-limit 60s
config *.radioMedium.obstacleLoss.typename ""
config *.hostR*.mobility.typename StationaryMobility
config *.host*.wlan[0].radio.transmitter.power 10mW
config *.hostA.numApps 1
config *.hostA.app[0].typename TcpBasicClientApp
config *.hostA.app[0].connectAddress "\"hostB\""
config *.hostA.app[0].connectPort 1000
config *.hostA.app[0].startTime 2s
config *.hostA.app[0].numRequestsPerSession 100
config *.hostA.app[0].requestLength 1000B
config *.hostA.app[0].replyLength 100B
config *.hostA.app[0].thinkTime 0.01s
config *.hostA.app[0].idleInterval 1s
config *.hostA.app[0].reconnectInterval 1s
config *.hostB.numApps 1
config *.hostB.app[0].typename TcpGenericServerApp
config *.hostB.app[0].localPort 1000
config *.hostB.app[0].replyDelay 0s
config *.hostR*.numApps 0
config *.host*.tcp.typename Tcp
config *.host*.tcp.sackSupport true
config *.host*.tcp.windowScalingSupport true
config *.host*.tcp.timestampSupport true
config *.host*.tcp.tcpAlgorithmClass "\"TcpReno\""
config *.host*.tcp.recordStats true
config *.host*.tcp.conn-*.cwnd:vector.result-recording-modes default
config *.host*.tcp.conn-*.cwnd:stats.result-recording-modes default
config *.host*.tcp.conn-*.ssthresh:vector.result-recording-modes default
config *.host*.tcp.conn-*.ssthresh:stats.result-recording-modes default
